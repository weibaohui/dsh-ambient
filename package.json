{
  "name": "@weibaohui/dsh-ambient",
  "version": "0.1.2",
  "description": "dsh 插件 · 白噪音播放器：场景完全由音频根目录下的文件夹决定（有什么算什么），点「执行下载」让 AI 后台从 Wikimedia Commons 按 CC0/PD/CC BY 分门别类下载到对应文件夹。顺序/随机/单曲循环/间歇四种播放模式 + N 小时或指定时刻定时关。宿主侧流式读取（Range 支持），不上传不分发。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "ambient",
    "white-noise",
    "scene",
    "nature-sounds",
    "web-audio",
    "dsh-plugin"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.1.7-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check client/scenes.js && node --check client/player.js && node --check client/index.js",
    "test": "node --test test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "npm run build:client && npm run check && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weibaohui/dsh-ambient.git"
  },
  "homepage": "https://github.com/weibaohui/dsh-ambient#readme",
  "bugs": {
    "url": "https://github.com/weibaohui/dsh-ambient/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@weibaohui/dsh-plugin-kit": "^0.5.0"
  }
}
